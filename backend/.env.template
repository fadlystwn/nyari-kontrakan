# Database settings
POSTGRES_DB=scraper_db
POSTGRES_USER=scraper_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_UNIQUE_PASSWORD
DATABASE_SSL_MODE=require  # Options: disable, allow, prefer, require, verify-ca, verify-full

# API Security
API_KEY=CHANGE_THIS_TO_A_STRONG_API_KEY
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Environment (development/production)
ENVIRONMENT=development

# Proxy List (comma-separated list of residential proxies)
# Example: http://user:pass@proxy1.webshare.io:10000,http://user:pass@proxy2.webshare.io:10001
PROXY_LIST=

# Gemini API Client Curation Module
GEMINI_API_KEY=
# Optional Tuning
CURATION_BATCH_SIZE=10
CURATION_RATE_LIMIT_DELAY=1
